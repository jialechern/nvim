
" begin 一般设置
syntax on					" 开启语法高亮

set number					" 显示行号
set relativenumber				" 显示从当前行数的前后行数
set cursorline					" 高亮显示当前行
set wrap					" 自动换行
set showcmd					" 显示指令
set wildmenu					" 命令补全
set hlsearch					" 高亮显示搜索
set incsearch					" 动态高亮搜索"
set igorecase					" 不区分大小写搜索
set smartcase					" 智能大小写搜索
" end 一般设置
